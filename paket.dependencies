source https://api.nuget.org/v3/index.json

framework: net10.0

storage: none

group Build
  source https://api.nuget.org/v3/index.json
  nuget Fake.Core.Target
  nuget Fake.DotNet.Cli
  nuget Fake.IO.FileSystem
  nuget Fake.DotNet.Testing.Expecto

group Main
  source https://api.nuget.org/v3/index.json
  # MCP SDK 2.0 for the stdio vision server
  nuget ModelContextProtocol ~> 2.0
  # Generic host used to build the stdio server
  nuget Microsoft.Extensions.Hosting
  # Cross-platform image decoding / validation / resizing
  nuget SixLabors.ImageSharp ~> 3.1
  # Required for Paket-based F# projects (ensures FSharp.Core ships to output)
  nuget FSharp.Core
  # HTTP client is part of the framework (System.Net.Http)

group Test
  source https://api.nuget.org/v3/index.json
  nuget Expecto ~> 10.2
  nuget YoloDev.Expecto.TestSdk ~> 0.15
  nuget SixLabors.ImageSharp ~> 3.1
  nuget FSharp.Core
