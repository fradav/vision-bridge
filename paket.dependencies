source https://api.nuget.org/v3/index.json

framework: net10.0

storage: none

group Build
  source https://api.nuget.org/v3/index.json
  nuget Fake.Core.Target
  nuget Fake.DotNet.Cli
  nuget Fake.IO.FileSystem
  nuget Fake.DotNet.Testing.Expecto

group Main
  source https://api.nuget.org/v3/index.json
  # FsMcp: idiomatic F# MCP server toolkit (wraps the official C# MCP SDK)
  nuget FsMcp.Server ~> 1.2
  # FsMcp 1.2.2 is built/tested against the official MCP C# SDK 1.2.0; pin the
  # exact versions so a different SDK major/minor can't break FsMcp at runtime.
  # The metapackage and the Core assembly must agree (Core resolved to 2.0.0
  # otherwise, which lacks types FsMcp 1.2.2 references).
  nuget ModelContextProtocol 1.2.0
  nuget ModelContextProtocol.Core 1.2.0
  # Generic host used by FsMcp to build the stdio server
  nuget Microsoft.Extensions.Hosting
  # ImageMagick via Magick.NET (Apache-2.0): best-in-class format/quality support.
  # The Q16-AnyCPU package bundles the native libraries for all platforms (win,
  # linux, macOS arm64), so the cross-platform global tool works on any OS.
  nuget Magick.NET-Q16-AnyCPU ~> 14.16
  # Required for Paket-based F# projects (ensures FSharp.Core ships to output)
  nuget FSharp.Core
  # HTTP client is part of the framework (System.Net.Http)

group Test
  source https://api.nuget.org/v3/index.json
  nuget Expecto ~> 10.2
  nuget YoloDev.Expecto.TestSdk ~> 0.15
  nuget Magick.NET-Q16-AnyCPU ~> 14.16
  nuget FSharp.Core
